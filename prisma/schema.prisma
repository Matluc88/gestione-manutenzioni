generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utente {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  passwordHash  String
  ruolo         Ruolo     @default(COLLABORATORE)
  attivo        Boolean   @default(true)
  creatoIl      DateTime  @default(now())
  
  impiantiCreati Impianto[]
  report         Report[]
  
  @@map("utenti")
}

enum Ruolo {
  ADMIN
  COLLABORATORE
}

model Impianto {
  id              Int       @id @default(autoincrement())
  nome            String    @db.VarChar(100)
  proprieta       String?   @db.VarChar(100)
  inManutenzione  Boolean   @default(true)
  inIntervento    Boolean   @default(true)
  creatoIl        DateTime  @default(now())
  
  creatoId    Int
  creatoUtente Utente   @relation(fields: [creatoId], references: [id])
  
  report       Report[]
  componenti   Componente[]
  
  @@map("impianti")
}

model Report {
  id            Int       @id @default(autoincrement())
  codice        String    @unique @db.VarChar(20)
  tipo          TipoReport
  stato         StatoReport @default(BOZZA)
  pdfPath       String?
  creatoIl      DateTime  @default(now())
  modificatoIl  DateTime  @updatedAt
  
  impiantoId    Int
  impianto      Impianto  @relation(fields: [impiantoId], references: [id])
  utenteId      Int
  utente        Utente    @relation(fields: [utenteId], references: [id])
  attivita      Attivita[]
  
  @@map("report")
  @@index([codice, stato, creatoIl])
  @@index([impiantoId])
  @@index([utenteId])
  @@index([stato])
  @@index([tipo])
  @@index([creatoIl])
}

enum TipoReport {
  MANUTENZIONE
  INTERVENTO
}

enum StatoReport {
  BOZZA
  IN_LAVORAZIONE
  COMPLETATO
}

model Componente {
  id            Int       @id @default(autoincrement())
  nome          String    @db.VarChar(100)
  predefinito   Boolean   @default(false)
  
  impiantoId    Int?
  impianto      Impianto? @relation(fields: [impiantoId], references: [id])
  attivita      Attivita[]
  
  @@map("componenti")
}

model Attivita {
  id              Int       @id @default(autoincrement())
  descrizione     String    @db.Text
  stato           StatoAttivita
  motivazione     String?   @db.Text
  note            String?   @db.Text
  ordine          Int       @default(0)
  
  reportId        Int
  report          Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  componenteId    Int?
  componente      Componente? @relation(fields: [componenteId], references: [id])
  
  foto            Foto[]
  
  @@map("attivita")
  @@index([reportId])
  @@index([componenteId])
}

enum StatoAttivita {
  FATTO
  NON_FATTO
  NON_APPLICABILE
}

model Impostazioni {
  id                Int     @id @default(1)
  nomeAzienda       String  @default("ONE-M ENERGY SOLUTIONS")
  indirizzo         String?
  telefono          String?
  email             String?
  partitaIva        String?
  logoPath          String?
  intestazionePdf   String  @db.Text @default("")
  
  @@map("impostazioni")
}

model Foto {
  id          Int       @id @default(autoincrement())
  filePath    String
  fileName    String
  fileSize    Int
  mimeType    String
  caricataIl  DateTime  @default(now())
  
  attivitaId  Int
  attivita    Attivita  @relation(fields: [attivitaId], references: [id], onDelete: Cascade)
  
  @@map("foto")
  @@index([attivitaId])
}
